# Copy to .env and fill in. .env is gitignored; never commit keys.

# --- CoinMarketCap (required) -------------------------------------------
CMC_API_KEY=

# --- The model under test: any OpenAI-compatible endpoint with tool calling
# Pick ONE way to configure it (see litmus/llm.py for the full resolution order).

# a) A preset: gemini | openai | anthropic | openrouter | ollama
#    (or pass --provider / --model on the command line)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=          # free tier works; the harness was developed on it

# b) Any other OpenAI-compatible server (vLLM, LM Studio, Groq, Together, ...)
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=my-model
# LLM_API_KEY=

# Optional: sent to the model as reasoning_effort (or pass --reasoning-effort).
# Some OpenAI models (gpt-6-sol, gpt-5.6-*) accept tool calls only with "none".
# LLM_REASONING_EFFORT=none

# Legacy (still honored for Gemini): GEMINI_MODEL=gemini-3.5-flash-lite
